# -----------------------------------------------------------------------------
# Mesh API (mandatory — every LLM/AI call goes through here)
# Mesh is OpenAI-compatible, so we drive it with the openai SDK.
# -----------------------------------------------------------------------------
MESH_API_KEY=your_mesh_api_key_here
# Set this to the base URL shown on your Mesh dashboard (must end at /v1)
MESH_BASE_URL=https://api.mesh.io/v1
# Model IDs for chat and embeddings — pick from your Mesh dashboard
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_EMBED_MODEL=openai/text-embedding-3-small

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/trove.db
CHROMA_PERSIST_DIR=./chroma_db

# -----------------------------------------------------------------------------
# LangSmith tracing (optional bonus)
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trove

# -----------------------------------------------------------------------------
# Scheduler — daily digest send time (24h clock, server local time)
# -----------------------------------------------------------------------------
DIGEST_HOUR=15
DIGEST_MINUTE=0

# -----------------------------------------------------------------------------
# Recommendation refresh policy
# -----------------------------------------------------------------------------
# Minimum new events before we consider re-running the agent
RECO_MIN_NEW_EVENTS=5
# Minimum minutes between agent runs for the same user
RECO_MIN_INTERVAL_MINUTES=10
